# Normalize text in Git, but leave binary assets untouched.
* text=auto

# Preserve Unix newlines when cloned/checked out from Windows Git or WSL.
# These files are executed or parsed on Linux (including inside Docker).
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.env       text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
